{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/web/src",
  "tags": ["type:app"],
  "targets": {
    "i18n": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/src/app/**/i18n/{en,pl}.json",
        "{projectRoot}/scripts/merge-i18n.mts",
        "{projectRoot}/src/app/i18n/merge-dictionaries.ts"
      ],
      "outputs": ["{projectRoot}/generated/i18n"],
      "options": {
        "command": "node --experimental-strip-types apps/web/scripts/merge-i18n.mts"
      }
    },
    "build": {
      "executor": "@angular/build:application",
      "dependsOn": ["i18n"],
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/web",
        "browser": "apps/web/src/main.ts",
        "tsConfig": "apps/web/tsconfig.app.json",
        "inlineStyleLanguage": "less",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/web/public"
          },
          {
            "glob": "*.json",
            "input": "apps/web/generated/i18n",
            "output": "i18n"
          }
        ],
        "styles": [
          "apps/web/src/styles.less",
          {
            "input": "apps/web/src/theme/light.less",
            "bundleName": "light",
            "inject": false
          },
          {
            "input": "apps/web/src/theme/dark.less",
            "bundleName": "dark",
            "inject": false
          }
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "optimization": {
            "scripts": true,
            "styles": {
              "minify": true,
              "inlineCritical": false
            },
            "fonts": true
          }
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "dependsOn": ["i18n"],
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "web:build:production"
        },
        "development": {
          "buildTarget": "web:build:development"
        }
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "dependsOn": ["i18n"],
      "options": {
        "watch": false
      }
    },
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "web:build",
        "port": 4300,
        "staticFilePath": "dist/apps/web/browser",
        "spa": true
      }
    }
  }
}
