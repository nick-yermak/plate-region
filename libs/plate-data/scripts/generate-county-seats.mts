/**
 * Generate county-seats-data.ts from the pdftotext -layout dump of M.P. 2017 poz. 853.
 *
 * Usage:
 *   node libs/plate-data/scripts/generate-county-seats.mts <path to M20170853.txt>
 */

import { createJiti } from 'jiti';
import { fileURLToPath } from 'node:url';
import { dirname, resolve } from 'node:path';
import { format, resolveConfig } from 'prettier';
import { readFileSync, writeFileSync } from 'node:fs';

import type { Region1, Region2, Registry } from '../src/lib/pl/model.ts';

const SCRIPT_DIR = dirname(fileURLToPath(import.meta.url));
const ROOT = resolve(SCRIPT_DIR, '../../..');
const OUT_PATH = resolve(SCRIPT_DIR, '../src/lib/pl/county-seats-data.ts');

const FILE_HEADER = [
  '// Generated by libs/plate-data/scripts/generate-county-seats.mts — do not edit by hand.',
  '// Source: Obwieszczenie Prezesa Rady Ministrów (M.P. 2017 poz. 853); see countySeatsProvenance.',
  '// Regenerate:',
  '//   node libs/plate-data/scripts/generate-county-seats.mts <path to M20170853.txt>',
].join('\n');

const LIST_MARKER = 'WYKAZ GMIN I POWIATÓW WCHODZĄCYCH W SKŁAD WOJEWÓDZTW';
const SEAT_RE = /^[\p{Lu}][\p{L} -]*$/u;

/**
 * Registry renames since the 2017 list. Dz.U. 2020 poz. 1331 (Rozporządzenie Rady
 * Ministrów z dnia 29 lipca 2020 r.), from 2021-01-01.
 */
const RENAMES: ReadonlyArray<{
  readonly voivodeship: string;
  readonly from: string;
  readonly to: string;
}> = [{ voivodeship: 'dolnośląskie', from: 'jeleniogórski', to: 'karkonoski' }];

interface LandSeat {
  readonly voivodeship: string;
  readonly name: string;
  readonly seat: string;
  readonly line: number;
}

function fail(message: string): never {
  process.stderr.write(`${message}\n`);
  process.exit(1);
}

function loadRegistry(): Registry {
  // Load registry.ts directly: importing the package index runs decodeCountySeats
  // on this module's output and would fail before the first write.
  const jiti = createJiti(resolve(ROOT, 'package.json'), {
    fsCache: false,
    moduleCache: false,
    alias: {
      '@plate-region/plate-data': resolve(ROOT, 'libs/plate-data/src/index.ts'),
      '@plate-region/plate-domain': resolve(
        ROOT,
        'libs/plate-domain/src/index.ts',
      ),
    },
  });
  const data = jiti(
    resolve(ROOT, 'libs/plate-data/src/lib/pl/registry.ts'),
  ) as {
    registry: Registry;
  };
  return data.registry;
}

function clean(line: string): string {
  return line.replace(/\f/g, '').replace(/^\uFEFF/, '');
}

function isFurniture(line: string): boolean {
  const t = clean(line);
  if (!t.trim()) return true;
  if (/Monitor Polski/.test(t)) return true;
  if (/Poz\.\s*853/.test(t)) return true;
  if (/[–-]\s*\d+\s*[–-]/.test(t)) return true;
  if (t.includes(LIST_MARKER)) return true;
  if (/^\s*Województwo\s+Powiat/.test(t)) return true;
  if (/Siedziba władz/.test(t)) return true;
  if (/^\s*\(m\.\)\*/.test(t)) return true;
  if (/gminy\/powiatu/.test(t)) return true;
  if (/^\s*1\s+2\s+3\s+4\s*$/.test(t)) return true;
  if (/^\s*miasta na prawach powiatu\s*$/.test(t)) return true;
  if (/^\s*\d+\s*$/.test(t)) return true;
  if (/^\s*\*{1,2}\s/.test(t)) return true;
  return false;
}

function splitCols(line: string): readonly [string, string] | null {
  const t = clean(line).trimEnd();
  const m = t.match(/^(\s*)(\S.*?)\s{2,}(\S.*\S|\S)\s*$/);
  if (m === null) return null;
  return [m[2].trim(), m[3].trim()];
}

/** Digits, or a leading l/I from pdftotext confusing 1. */
function isGminaFirstColumn(value: string): boolean {
  return /^\d+\./.test(value) || /^[lI]\d+\./.test(value);
}

function nextContentIndex(lines: readonly string[], from: number): number {
  let j = from;
  while (j < lines.length && isFurniture(lines[j] as string)) j++;
  return j;
}

function parseLandSeats(
  lines: readonly string[],
  start: number,
  voivodeshipNames: ReadonlySet<string>,
): LandSeat[] {
  const land: LandSeat[] = [];
  let voivodeship: string | null = null;
  let i = start;
  while (i < lines.length) {
    const raw = lines[i] as string;
    const lineNo = i + 1;
    if (isFurniture(raw)) {
      i++;
      continue;
    }
    const trimmed = clean(raw).trim();
    const colsAtTrim = splitCols(raw);
    if (
      isGminaFirstColumn(trimmed) ||
      (colsAtTrim !== null && isGminaFirstColumn(colsAtTrim[0]))
    ) {
      i++;
      continue;
    }
    const cols = splitCols(raw);
    if (cols === null) {
      fail(`unclassified line ${lineNo}: ${JSON.stringify(clean(raw))}`);
    }
    let [name] = cols;
    const seat = cols[1];
    if (name.endsWith('-')) {
      const j = nextContentIndex(lines, i + 1);
      if (j >= lines.length) {
        fail(`wrapped name without continuation at line ${lineNo}`);
      }
      const contRaw = lines[j] as string;
      const cont = clean(contRaw).trim();
      if (cont.startsWith('-') && splitCols(contRaw) === null) {
        name = `${name}${cont.slice(1)}`;
        i = j;
      } else {
        fail(
          `wrapped name at line ${lineNo} has unexpected continuation at ${j + 1}: ${JSON.stringify(cont)}`,
        );
      }
    } else {
      const j = nextContentIndex(lines, i + 1);
      if (j < lines.length) {
        const contRaw = lines[j] as string;
        const contCols = splitCols(contRaw);
        const cont = clean(contRaw).trim();
        if (
          contCols === null &&
          !isGminaFirstColumn(cont) &&
          !cont.startsWith('-') &&
          /^[\p{Ll}][\p{L} -]*$/u.test(cont)
        ) {
          name = `${name} ${cont}`;
          i = j;
        }
      }
    }
    if (voivodeshipNames.has(name)) {
      voivodeship = name;
      i++;
      continue;
    }
    if (voivodeship === null) {
      fail(`county before any voivodeship at line ${lineNo}: ${name}`);
    }
    land.push({ voivodeship, name, seat, line: lineNo });
    i++;
  }
  return land;
}

function citySeat(region2: Region2): string {
  if (region2.name === 'm.st. Warszawa') return 'Warszawa';
  if (region2.name.includes('.')) {
    fail(`city county name contains a dot: ${region2.name}`);
  }
  return region2.name;
}

function matchLandSeats(
  land: readonly LandSeat[],
  region1: readonly Region1[],
  region2: readonly Region2[],
): Map<string, string> {
  const renameTo = new Map(
    RENAMES.map((r) => [`${r.voivodeship}\0${r.from}`, r.to]),
  );
  const byKey = new Map<string, LandSeat>();
  const duplicates: string[] = [];
  for (const row of land) {
    const name = renameTo.get(`${row.voivodeship}\0${row.name}`) ?? row.name;
    const key = `${row.voivodeship}\0${name}`;
    if (byKey.has(key)) duplicates.push(key);
    byKey.set(key, { ...row, name });
  }

  const letterOf = new Map(region1.map((r) => [r.name, r.letters[0]]));
  const nameOf = new Map(region1.map((r) => [r.letters[0], r.name]));
  const regLand = region2.filter((r) => r.kind === 'land');
  const inListNotRegistry: string[] = [];
  const inRegistryNotList: string[] = [];

  for (const [key, row] of byKey) {
    const letter = letterOf.get(row.voivodeship);
    if (
      letter === undefined ||
      !regLand.some((r) => r.region1Letter === letter && r.name === row.name)
    ) {
      inListNotRegistry.push(key.replace('\0', '/'));
    }
  }
  for (const r of regLand) {
    const voiv = nameOf.get(r.region1Letter);
    const key = `${voiv}\0${r.name}`;
    if (!byKey.has(key)) {
      inRegistryNotList.push(`${voiv}/${r.name}`);
    }
  }

  if (
    duplicates.length > 0 ||
    inListNotRegistry.length > 0 ||
    inRegistryNotList.length > 0 ||
    byKey.size !== 314
  ) {
    fail(
      [
        `land seat match failed: list=${byKey.size} registryLand=314`,
        duplicates.length > 0 ? `duplicates: ${duplicates.join(', ')}` : '',
        inListNotRegistry.length > 0
          ? `in list not registry: ${inListNotRegistry.join(', ')}`
          : '',
        inRegistryNotList.length > 0
          ? `in registry not list: ${inRegistryNotList.join(', ')}`
          : '',
      ]
        .filter((s) => s !== '')
        .join('\n'),
    );
  }

  const seatsByCode = new Map<string, string>();
  for (const r of regLand) {
    const voiv = nameOf.get(r.region1Letter) as string;
    const row = byKey.get(`${voiv}\0${r.name}`) as LandSeat;
    const code = `${r.region1Letter}${r.suffixes[0]}`;
    seatsByCode.set(code, row.seat);
  }
  return seatsByCode;
}

function firstCode(region2: Region2): string {
  return `${region2.region1Letter}${region2.suffixes[0]}`;
}

async function writeFormatted(filePath: string, source: string): Promise<void> {
  const config = await resolveConfig(filePath, { editorconfig: true });
  const formatted = await format(source, {
    ...config,
    filepath: filePath,
  });
  writeFileSync(filePath, formatted, 'utf8');
}

async function main(): Promise<void> {
  const inputPath = process.argv[2];
  if (inputPath === undefined) {
    fail(
      'usage: node libs/plate-data/scripts/generate-county-seats.mts <path to M20170853.txt>',
    );
  }
  const registry = loadRegistry();
  const voivodeshipNames = new Set(registry.region1.map((r) => r.name));
  const text = readFileSync(resolve(inputPath), 'utf8');
  const lines = text.split(/\r?\n/);
  const start = lines.findIndex((l) => clean(l).includes(LIST_MARKER));
  if (start < 0) {
    fail(`list marker not found: ${LIST_MARKER}`);
  }

  const land = parseLandSeats(lines, start, voivodeshipNames);
  const landSeats = matchLandSeats(land, registry.region1, registry.region2);

  const seats: string[] = [];
  for (const r of registry.region2) {
    const code = firstCode(r);
    let seat: string;
    if (r.kind === 'city') {
      seat = citySeat(r);
    } else {
      const fromList = landSeats.get(code);
      if (fromList === undefined) {
        fail(`missing land seat for ${code}`);
      }
      seat = fromList;
    }
    if (!SEAT_RE.test(seat)) {
      fail(`seat for ${code} fails the seat pattern: ${JSON.stringify(seat)}`);
    }
    seats.push(seat);
  }

  if (seats.length !== 380) {
    fail(`expected 380 seats, got ${seats.length}`);
  }

  const body = seats
    .map((seat, i) => {
      const code = firstCode(registry.region2[i] as Region2);
      return `  ${JSON.stringify(seat)}, // ${code}`;
    })
    .join('\n');

  const source =
    `${FILE_HEADER}\n\n` +
    `export const countySeats = [\n${body}\n] as const satisfies readonly string[];\n`;

  await writeFormatted(OUT_PATH, source);
  process.stderr.write(`wrote ${OUT_PATH} (${seats.length} seats)\n`);
}

await main();
