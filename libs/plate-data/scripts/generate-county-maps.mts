  );
}

function mergePolygons(
  topo: Topology,
  geoms: GeometryObject[],
): Polygon | MultiPolygon {
  return topoMerge(topo, geoms as never) as Polygon | MultiPolygon;
}

function geomFromTopo(
  topo: Topology,
  geom: GeometryObject,
): Polygon | MultiPolygon | null {
  const feat = topoFeature(topo, geom) as Feature<
    Polygon | MultiPolygon | null
  >;
  return feat.geometry;
}

function generateVoivodeshipModule(
  letter: string,
  counties: readonly MatchedCounty[],
  region2: readonly Region2[],
): GeneratedModule {
  const own = counties.filter((c) => c.region1Letter === letter);
  const registryOrder = region2.filter((r) => r.region1Letter === letter);
  if (own.length !== registryOrder.length) {
    fail(
      `voivodeship ${letter}: matched ${own.length} counties, registry has ${registryOrder.length}`,
    );
  }

  const target: FeatureCollection<Polygon | MultiPolygon> = {
    type: 'FeatureCollection',
    features: own.map((c) => ({
      type: 'Feature',
      properties: { teryt: c.teryt },
      geometry: c.geometry,
    })),
  };
  const { projection, height } = fitProjection(target);

  const projectedCounties: FeatureCollection<Polygon | MultiPolygon> = {
    type: 'FeatureCollection',
    features: counties.map((c) => ({
      type: 'Feature',
      properties: {
        teryt: c.teryt,
        region1Letter: c.region1Letter,
        firstSuffix: c.firstSuffix,
      },
      geometry: projectGeometry(c.geometry, projection),
    })),
  };

  const topo = simplify(
    presimplify(topology({ counties: projectedCounties }) as never),
    MIN_WEIGHT,
  ) as CountyTopology;

  const byTeryt = new Map<string, GeometryObject>();
  for (const geom of topo.objects.counties.geometries) {
    const props = geom.properties as { teryt: string };
    byTeryt.set(props.teryt, geom);
  }

  let pathVertices = 0;
  const countyRows: CountyMapCounty[] = [];
  for (const r2 of registryOrder) {
    const matched = expectDefined(
      own.find(
        (c) =>
          c.region1Letter === r2.region1Letter &&
          c.firstSuffix === r2.suffixes[0],
      ),
      `matched county for ${r2.region1Letter}${r2.suffixes[0]}`,
    );
    const geom = expectDefined(
      byTeryt.get(matched.teryt),
      `topology geometry for ${matched.teryt}`,
    );
    const simplified = geomFromTopo(topo, geom);
    const encoded = encodePath(simplified, height);
    const path = assertPathNonEmpty(
      encoded.path,
      simplified,
      `county ${matched.region1Letter}${matched.firstSuffix} (${matched.teryt})`,
    );
    pathVertices += encoded.vertices;
    countyRows.push({
      region1Letter: matched.region1Letter,
      firstSuffix: matched.firstSuffix,
      teryt: matched.teryt,
      path,
      label: labelFor(expectDefined(simplified, matched.teryt)),
    });
  }

  const ownGeoms = registryOrder.map((r2) => {
    const matched = expectDefined(
      own.find(
        (c) =>
          c.region1Letter === r2.region1Letter &&
          c.firstSuffix === r2.suffixes[0],
      ),
      `own county ${r2.region1Letter}${r2.suffixes[0]}`,
    );
    return expectDefined(byTeryt.get(matched.teryt), matched.teryt);
  });
  const outlineGeom = mergePolygons(topo, ownGeoms);
  const outlineEncoded = encodePath(outlineGeom, height);
  const outline = assertPathNonEmpty(
    outlineEncoded.path,
    outlineGeom,
    `outline of voivodeship ${letter}`,
  );
  pathVertices += outlineEncoded.vertices;

  const letterToVoivodeshipCode = new Map<string, string>();
  for (const c of counties) {
    letterToVoivodeshipCode.set(c.region1Letter, c.voivodeshipCode);
  }
  const otherLetters = [
    ...new Set(
      counties.map((c) => c.region1Letter).filter((l) => l !== letter),
    ),
  ].sort((a, b) => {
    const ca = expectDefined(letterToVoivodeshipCode.get(a), a);
    const cb = expectDefined(letterToVoivodeshipCode.get(b), b);
    return ca < cb ? -1 : ca > cb ? 1 : 0;
  });

  const neighbours: string[] = [];
  for (const other of otherLetters) {
    const geoms = counties
      .filter((c) => c.region1Letter === other)
      .map((c) => expectDefined(byTeryt.get(c.teryt), c.teryt));
    const merged = mergePolygons(topo, geoms);
    const encoded = encodePath(merged, height);
    if (encoded.path !== '') {
      neighbours.push(encoded.path);
      pathVertices += encoded.vertices;
    }
  }

  assertNoPathCrossings(
    `county-map-${letter.toLowerCase()}.ts`,
    countyRows.map((c) => ({
      name: `${c.region1Letter}${c.firstSuffix}`,
      path: c.path,
    })),
  );

  const map: CountyMap = {
    viewBox: { width: W, height },
    outline,
    counties: countyRows,
    neighbours,
  };

  return {
    fileName: `county-map-${letter.toLowerCase()}.ts`,
    source: moduleSource('CountyMap', 'countyMap', serializeCountyMap(map)),
    countiesOrDistricts: countyRows.length,
    pathVertices,
    rawBudget: RAW_BUDGET,
    gzipBudget: GZIP_BUDGET,
  };
}

function generateWarsawModule(
  counties: readonly MatchedCounty[],
  districts: readonly MatchedDistrict[],
  minWeight: number,
  options: { readonly assertCrossings?: boolean } = {},
): GeneratedModule & {
  readonly areaRatioBefore: number;
  readonly areaRatioAfter: number;
  readonly crossingCount: number;
} {
  const target: FeatureCollection<Polygon | MultiPolygon> = {
    type: 'FeatureCollection',
    features: districts.map((d) => ({
      type: 'Feature',
      properties: { teryt: d.teryt },
      geometry: d.geometry,
    })),
  };
  const { projection, height } = fitProjection(target);

  const projectedCounties: FeatureCollection<Polygon | MultiPolygon> = {
    type: 'FeatureCollection',
    features: counties.map((c) => ({
      type: 'Feature',
      properties: { teryt: c.teryt, region1Letter: c.region1Letter },
      geometry: projectGeometry(c.geometry, projection),
    })),
  };
  const projectedDistricts: FeatureCollection<Polygon | MultiPolygon> = {
    type: 'FeatureCollection',
    features: districts.map((d) => ({
      type: 'Feature',
      properties: { teryt: d.teryt, name: d.name },
      geometry: projectGeometry(d.geometry, projection),
    })),
  };

  const warsawCounty = expectDefined(
    counties.find((c) => c.teryt === '1465'),
    'Warsaw county 1465',
  );
  const warsawProjected = projectGeometry(warsawCounty.geometry, projection);
  const countyAreaBefore = Math.abs(geoArea(warsawProjected));

  const preTopo = topology({
    counties: projectedCounties,
    districts: projectedDistricts,
  }) as WarsawTopology;
  const districtMergeBefore = mergePolygons(
    preTopo,
    preTopo.objects.districts.geometries,
  );
  const areaRatioBefore =
    Math.abs(geoArea(districtMergeBefore)) / countyAreaBefore;

  const topo = simplify(
    presimplify(preTopo as never),
    minWeight,
  ) as WarsawTopology;

  let pathVertices = 0;
  const districtRows: WarsawDistrictMapDistrict[] = [];
  for (let i = 0; i < districts.length; i++) {
    const meta = expectDefined(districts[i], `district ${i}`);
    const geom = expectDefined(
      topo.objects.districts.geometries[i],
      `district geom ${i}`,
    );
    const simplified = geomFromTopo(topo, geom);
    const encoded = encodePath(simplified, height);
    const path = assertPathNonEmpty(
      encoded.path,
      simplified,
      `district ${meta.name} (${meta.teryt})`,
    );
    pathVertices += encoded.vertices;
    districtRows.push({
      name: meta.name,
      teryt: meta.teryt,
      path,
      label: labelFor(expectDefined(simplified, meta.teryt)),
    });
  }

  const outlineGeom = mergePolygons(topo, topo.objects.districts.geometries);
  const outlineEncoded = encodePath(outlineGeom, height);
  const outline = assertPathNonEmpty(
    outlineEncoded.path,
    outlineGeom,
    'Warsaw outline',
  );
  pathVertices += outlineEncoded.vertices;

  const countyByTeryt = new Map<string, GeometryObject>();
  for (const geom of topo.objects.counties.geometries) {
    const props = geom.properties as { teryt: string };
    countyByTeryt.set(props.teryt, geom);
  }

  const neighbours: string[] = [];
  for (const c of counties) {
    if (c.teryt === '1465') continue;
    const geom = expectDefined(countyByTeryt.get(c.teryt), c.teryt);
    const simplified = geomFromTopo(topo, geom);
    const encoded = encodePath(simplified, height);
    if (encoded.path !== '') {
      neighbours.push(encoded.path);
      pathVertices += encoded.vertices;
    }
  }

  const districtMergeAfter = mergePolygons(
    topo,
    topo.objects.districts.geometries,
  );
  const warsawGeomAfter = expectDefined(
    countyByTeryt.get('1465'),
    '1465 after simplify',
  );
  const warsawFeatAfter = geomFromTopo(topo, warsawGeomAfter);
  if (warsawFeatAfter === null) {
    fail('Warsaw county 1465 empty after simplification');
  }
  const areaRatioAfter =
    Math.abs(geoArea(districtMergeAfter)) / Math.abs(geoArea(warsawFeatAfter));

  const namedDistricts = districtRows.map((d) => ({
    name: d.name,
    path: d.path,
  }));
  const crossingCount = findPathCrossings(namedDistricts).length;
  if (options.assertCrossings !== false) {
    assertNoPathCrossings('warsaw-district-map.ts', namedDistricts);
  }

  const map: WarsawDistrictMap = {
    viewBox: { width: W, height },
    outline,
    districts: districtRows,
    neighbours,
  };

  return {
    fileName: 'warsaw-district-map.ts',
    source: moduleSource(
      'WarsawDistrictMap',
      'warsawDistrictMap',
      serializeWarsawMap(map),
    ),
    countiesOrDistricts: districtRows.length,
    pathVertices,
    rawBudget: RAW_BUDGET,
    gzipBudget: GZIP_BUDGET,
    areaRatioBefore,
    areaRatioAfter,
    crossingCount,
  };
}

