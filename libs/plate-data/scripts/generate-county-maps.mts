type CountyTopology = Topology<{ counties: GeometryCollection }>;
type WarsawTopology = Topology<{
  counties: GeometryCollection;
  districts: GeometryCollection;
}>;

type Point = readonly [number, number];

function fail(message: string): never {
  throw new Error(message);
}

function expectDefined<T>(value: T | undefined | null, expected: string): T {
  if (value === undefined || value === null) {
    fail(`expected ${expected}, got ${String(value)}`);
  }
  return value;
}

function round1(n: number): number {
  return Math.round(n * 10) / 10;
}

function stripPowiatPrefix(name: string): string {
  return name.startsWith('powiat ') ? name.slice('powiat '.length) : name;
}

function stripDistrictSuffix(name: string): string {
  return name.endsWith(' - dzielnica')
    ? name.slice(0, -' - dzielnica'.length)
    : name;
}

function countyKind(teryt: string): 'city' | 'land' {
  return Number(teryt.slice(2, 4)) >= 61 ? 'city' : 'land';
}

function loadData(): {
  readonly registry: Registry;
  readonly warsawDistricts: WarsawDistrictsData;
} {
  const jiti = createJiti(resolve(ROOT, 'package.json'), {
    fsCache: false,
    moduleCache: false,
    alias: {
      '@plate-region/plate-data': resolve(ROOT, 'libs/plate-data/src/index.ts'),
      '@plate-region/plate-domain': resolve(
        ROOT,
        'libs/plate-domain/src/index.ts',
      ),
    },
  });
  const data = jiti(resolve(ROOT, 'libs/plate-data/src/index.ts')) as {
    registry: Registry;
    warsawDistricts: WarsawDistrictsData;
  };
  return {
    registry: data.registry,
    warsawDistricts: data.warsawDistricts,
  };
}

function projectPosition(
  position: Position,
  projection: (coords: [number, number]) => [number, number] | null,
): Position {
  const projected = projection([position[0], position[1]]);
  if (projected === null) {
    fail(`projection returned null for ${position[0]}, ${position[1]}`);
  }
  return projected;
}

function projectRing(
  ring: Position[],
  projection: (coords: [number, number]) => [number, number] | null,
): Position[] {
  return ring.map((p) => projectPosition(p, projection));
}

function projectGeometry(
  geometry: Polygon | MultiPolygon,
  projection: (coords: [number, number]) => [number, number] | null,
): Polygon | MultiPolygon {
  if (geometry.type === 'Polygon') {
    return {
      type: 'Polygon',
      coordinates: geometry.coordinates.map((ring) =>
        projectRing(ring, projection),
      ),
    };
  }
  return {
    type: 'MultiPolygon',
    coordinates: geometry.coordinates.map((polygon) =>
      polygon.map((ring) => projectRing(ring, projection)),
    ),
  };
}

/** Recording context; throws on unsupported drawing commands. */
class RelativePathContext {
  private rings: Point[][] = [];
  private current: Point[] | null = null;
  private last: Point | null = null;

  moveTo(x: number, y: number): void {
    this.flushRing();
    const p: Point = [Math.round(x), Math.round(y)];
    this.current = [p];
    this.last = p;
  }

  lineTo(x: number, y: number): void {
    if (this.current === null || this.last === null) {
      fail('lineTo without moveTo');
    }
    const p: Point = [Math.round(x), Math.round(y)];
    if (p[0] === this.last[0] && p[1] === this.last[1]) return;
    this.current.push(p);
    this.last = p;
  }

  closePath(): void {
    this.flushRing();
  }

  arc(): never {
    fail('RelativePathContext.arc is not supported');
  }

  rect(): never {
    fail('RelativePathContext.rect is not supported');
  }

  toPath(): string {
    this.flushRing();
    const parts: string[] = [];
    for (const ring of this.rings) {
      const start = expectDefined(ring[0], 'ring start');
      const [x0, y0] = start;
      let s = `M${x0} ${y0}l`;
      const deltas: number[] = [];
      for (let i = 1; i < ring.length; i++) {
        const [x, y] = expectDefined(ring[i], `ring point ${i}`);
        const [px, py] = expectDefined(ring[i - 1], `ring point ${i - 1}`);
        deltas.push(x - px, y - py);
      }
      const last = expectDefined(ring[ring.length - 1], 'ring end');
      const cdx = x0 - last[0];
      const cdy = y0 - last[1];
      if (cdx !== 0 || cdy !== 0) {
        deltas.push(cdx, cdy);
      }
      for (let i = 0; i < deltas.length; i++) {
        const n = expectDefined(deltas[i], `delta ${i}`);
        if (i > 0 && n >= 0) s += ' ';
        s += String(n);
      }
      s += 'z';
      parts.push(s);
    }
    return parts.join('');
  }

  vertexCount(): number {
    this.flushRing();
    return this.rings.reduce((n, ring) => n + ring.length, 0);
  }

  private flushRing(): void {
    if (this.current === null) return;
    const unique: Point[] = [];
    for (const p of this.current) {
      const prev = unique[unique.length - 1];
      if (prev && prev[0] === p[0] && prev[1] === p[1]) continue;
      unique.push(p);
    }
    if (unique.length >= 2) {
      const first = expectDefined(unique[0], 'ring first');
      const last = expectDefined(unique[unique.length - 1], 'ring last');
      if (first[0] === last[0] && first[1] === last[1]) {
        unique.pop();
      }
    }
    if (unique.length >= 3) {
      this.rings.push(unique);
    }
    this.current = null;
    this.last = null;
  }
}

function encodePath(
  geometry: Polygon | MultiPolygon | null,
  height: number,
): { path: string; vertices: number } {
  if (geometry === null) {
    return { path: '', vertices: 0 };
  }
  const ctx = new RelativePathContext();
  // d3's GeoContext typings require beginPath; the canvas/SVG subset we implement is enough.
  geoPath(
    geoIdentity().clipExtent([
      [0, 0],
      [W, height],
    ]),
    ctx as never,
  )(geometry);
  return { path: ctx.toPath(), vertices: ctx.vertexCount() };
}

function assertPathNonEmpty(
  path: string,
  geometry: Polygon | MultiPolygon | null,
  label: string,
): string {
  if (path === '') {
    fail(`empty path after simplification for ${label}`);
  }
  if (geometry === null || Math.abs(geoArea(geometry)) === 0) {
    fail(`zero planar area after simplification for ${label}`);
  }
  return path;
}

type PathPoint = readonly [number, number];

/** Same decoding as county-maps.spec.ts (without the Vitest expect). */
function decodePath(path: string): PathPoint[] {
  if (!PATH_GRAMMAR.test(path)) {
    fail(`path fails the path grammar: ${path.slice(0, 40)}`);
  }
  const points: PathPoint[] = [];
  let x = 0;
  let y = 0;
  for (const part of path.match(/[Mlz][^Mlz]*/g) ?? []) {
    const numbers = (part.slice(1).match(/-?\d+/g) ?? []).map(Number);
    if (part.startsWith('M')) {
      x = expectDefined(numbers[0], 'M x');
      y = expectDefined(numbers[1], 'M y');
      points.push([x, y]);
    } else {
      for (let i = 0; i < numbers.length; i += 2) {
        x += expectDefined(numbers[i], 'l dx');
        y += expectDefined(numbers[i + 1], 'l dy');
        points.push([x, y]);
      }
    }
  }
  return points;
}

/** Distinct vertices: per ring, drop the closing duplicate when last equals first. */
function ringVertexCount(path: string): number {
  let total = 0;
  for (const ringPath of path.match(/M[^M]*/g) ?? []) {
    const points = decodePath(ringPath);
    if (points.length === 0) continue;
    const first = expectDefined(points[0], 'ring first');
    const last = expectDefined(points[points.length - 1], 'ring last');
    if (first[0] === last[0] && first[1] === last[1]) {
      total += points.length - 1;
    } else {
      total += points.length;
    }
  }
  return total;
}

function pathRings(path: string): PathPoint[][] {
  const rings: PathPoint[][] = [];
  const re = /M[^M]*?z/g;
  let match: RegExpExecArray | null;
  while ((match = re.exec(path)) !== null) {
    const pts = decodePath(match[0]);
    if (pts.length >= 2) {
      const first = expectDefined(pts[0], 'ring first');
      const last = expectDefined(pts[pts.length - 1], 'ring last');
      if (first[0] === last[0] && first[1] === last[1]) {
        pts.pop();
      }
    }
    if (pts.length >= 3) rings.push(pts);
  }
  return rings;
}

function orient(a: PathPoint, b: PathPoint, c: PathPoint): number {
  return (b[0] - a[0]) * (c[1] - a[1]) - (b[1] - a[1]) * (c[0] - a[0]);
}

function properCross(
  a: PathPoint,
  b: PathPoint,
  c: PathPoint,
  d: PathPoint,
): boolean {
  if (
    (a[0] === c[0] && a[1] === c[1]) ||
    (a[0] === d[0] && a[1] === d[1]) ||
    (b[0] === c[0] && b[1] === c[1]) ||
    (b[0] === d[0] && b[1] === d[1])
  ) {
    return false;
  }
  const o1 = orient(a, b, c);
  const o2 = orient(a, b, d);
  const o3 = orient(c, d, a);
  const o4 = orient(c, d, b);
  return o1 * o2 < 0 && o3 * o4 < 0;
}

interface Seg {
  readonly a: PathPoint;
  readonly b: PathPoint;
  readonly box: {
    readonly minX: number;
    readonly maxX: number;
    readonly minY: number;
    readonly maxY: number;
  };
}

function segmentBox(a: PathPoint, b: PathPoint): Seg['box'] {
  return {
    minX: Math.min(a[0], b[0]),
    maxX: Math.max(a[0], b[0]),
    minY: Math.min(a[1], b[1]),
    maxY: Math.max(a[1], b[1]),
  };
}

function bboxOverlap(u: Seg['box'], v: Seg['box']): boolean {
  return !(
    u.maxX < v.minX ||
    v.maxX < u.minX ||
    u.maxY < v.minY ||
    v.maxY < u.minY
  );
}

function segmentsOf(rings: PathPoint[][]): Seg[] {
  const segs: Seg[] = [];
  for (const ring of rings) {
    for (let i = 0; i < ring.length; i++) {
      const a = expectDefined(ring[i], 'seg a');
      const b = expectDefined(ring[(i + 1) % ring.length], 'seg b');
      segs.push({ a, b, box: segmentBox(a, b) });
    }
  }
  return segs;
}

interface PathCrossing {
  readonly kind: 'self' | 'between';
  readonly names: readonly string[];
  readonly a: Seg;
  readonly b: Seg;
}

function findPathCrossings(
  units: ReadonlyArray<{ readonly name: string; readonly path: string }>,
): PathCrossing[] {
  const prepared = units.map((u) => ({
    name: u.name,
    segs: segmentsOf(pathRings(u.path)),
  }));
  const found: PathCrossing[] = [];

  for (const unit of prepared) {
    for (let i = 0; i < unit.segs.length; i++) {
      for (let j = i + 1; j < unit.segs.length; j++) {
        const si = expectDefined(unit.segs[i], 'si');
        const sj = expectDefined(unit.segs[j], 'sj');
        if (!bboxOverlap(si.box, sj.box)) continue;
        if (properCross(si.a, si.b, sj.a, sj.b)) {
          found.push({
            kind: 'self',
            names: [unit.name],
            a: si,
            b: sj,
          });
        }
      }
    }
  }

  for (let u = 0; u < prepared.length; u++) {
    for (let v = u + 1; v < prepared.length; v++) {
      const A = expectDefined(prepared[u], 'unit A');
      const B = expectDefined(prepared[v], 'unit B');
      for (const si of A.segs) {
        for (const sj of B.segs) {
          if (!bboxOverlap(si.box, sj.box)) continue;
          if (properCross(si.a, si.b, sj.a, sj.b)) {
            found.push({
              kind: 'between',
              names: [A.name, B.name],
              a: si,
              b: sj,
            });
          }
        }
      }
    }
  }
  return found;
}

function assertNoPathCrossings(
  moduleName: string,
  units: ReadonlyArray<{ readonly name: string; readonly path: string }>,
): void {
  const crossings = findPathCrossings(units);
  if (crossings.length === 0) return;
  const first = expectDefined(crossings[0], 'first crossing');
  fail(
    `path crossing in ${moduleName}: ${first.kind} ${first.names.join(' × ')} ` +
      `${JSON.stringify(first.a.a)}→${JSON.stringify(first.a.b)} × ` +
      `${JSON.stringify(first.b.a)}→${JSON.stringify(first.b.b)}` +
      (crossings.length > 1 ? ` (+${crossings.length - 1} more)` : ''),
  );
}

function largestPolygonRings(geometry: Polygon | MultiPolygon): number[][][] {
  if (geometry.type === 'Polygon') {
    return geometry.coordinates as number[][][];
  }
  let best = geometry.coordinates[0] as number[][][];
  let bestArea = -1;
  for (const polygon of geometry.coordinates) {
    const area = Math.abs(geoArea({ type: 'Polygon', coordinates: polygon }));
    if (area > bestArea) {
      bestArea = area;
      best = polygon as number[][][];
    }
  }
  return expectDefined(best, 'MultiPolygon part');
}

function labelFor(geometry: Polygon | MultiPolygon): MapLabel {
  const result = polylabel(
    largestPolygonRings(geometry) as [number, number][][],
    1,
  );
  return {
    x: round1(result[0]),
    y: round1(result[1]),
    radius: round1(result.distance),
  };
}

/** Integer x/y only (no radius), for the country module. */
function integerLabelFor(geometry: Polygon | MultiPolygon): {
  readonly x: number;
  readonly y: number;
} {
  const result = polylabel(
    largestPolygonRings(geometry) as [number, number][][],
    1,
  );
  return {
    x: Math.round(result[0]),
    y: Math.round(result[1]),
  };
}

function geometryRings(geometry: Polygon | MultiPolygon): PathPoint[][] {
  const polys =
    geometry.type === 'Polygon' ? [geometry.coordinates] : geometry.coordinates;
  const rings: PathPoint[][] = [];
  for (const poly of polys) {
    for (const ring of poly) {
      rings.push(ring.map((p) => [p[0], p[1]] as PathPoint));
    }
  }
  return rings;
}

/** Collect absolute arc indices from a TopoJSON geometry arcs tree. */
function collectArcIndices(arcs: unknown): number[] {
  const out: number[] = [];
  const walk = (node: unknown): void => {
    if (typeof node === 'number') {
      out.push(node < 0 ? ~node : node);
      return;
    }
    if (Array.isArray(node)) {
      for (const child of node) walk(child);
    }
  };
  walk(arcs);
  return out;
}

/**
 * Boost arc point weights so simplify(W) keeps the same points as
 * simplify(SMALL_COUNTY_WEIGHT) would: z' = z * (W / SMALL_COUNTY_WEIGHT).
 * Endpoints (non-finite z) are left alone.
 */
function boostSmallCountyArc(
  topo: CountyTopology,
  arcIndex: number,
  simplifyWeight: number,
): void {
  const factor = simplifyWeight / SMALL_COUNTY_WEIGHT;
  const arc = expectDefined(topo.arcs[arcIndex], `arc ${arcIndex}`) as [
    number,
    number,
    number?,
  ][];
  for (const p of arc) {
    const z = p[2];
    if (typeof z === 'number' && Number.isFinite(z)) {
      p[2] = z * factor;
    }
  }
}

function shoelaceArea(rings: PathPoint[][]): number {
  let area = 0;
  for (const ring of rings) {
    let a = 0;
    for (let i = 0; i < ring.length; i++) {
      const [x1, y1] = expectDefined(ring[i], 'shoelace a');
      const [x2, y2] = expectDefined(ring[(i + 1) % ring.length], 'shoelace b');
      a += x1 * y2 - x2 * y1;
    }
    area += Math.abs(a) / 2;
  }
  return area;
}

/** Relative encoding of open lines (the voivodeship border mesh). */
function encodeOpenPath(
  geometry: { type: string; coordinates: unknown } | null,
  height: number,
): string {
  if (geometry === null) {
    return '';
  }
  const parts: string[] = [];
  let last: Point | null = null;
  let current: Point[] | null = null;
  const flush = (): void => {
    if (current === null || current.length === 0) {
      current = null;
      last = null;
      return;
    }
    const unique: Point[] = [];
    for (const p of current) {
      const prev = unique[unique.length - 1];
      if (prev && prev[0] === p[0] && prev[1] === p[1]) continue;
      unique.push(p);
    }
    if (unique.length >= 2) {
      const start = expectDefined(unique[0], 'open start');
      let s = `M${start[0]} ${start[1]}l`;
      const deltas: number[] = [];
      for (let i = 1; i < unique.length; i++) {
        const [x, y] = expectDefined(unique[i], `open ${i}`);
        const [px, py] = expectDefined(unique[i - 1], `open ${i - 1}`);
        deltas.push(x - px, y - py);
      }
      for (let i = 0; i < deltas.length; i++) {
        const n = expectDefined(deltas[i], `od ${i}`);
        if (i > 0 && n >= 0) s += ' ';
        s += String(n);
      }
      parts.push(s);
    }
    current = null;
    last = null;
  };
  const ctx = {
    moveTo(x: number, y: number): void {
      flush();
      const p: Point = [Math.round(x), Math.round(y)];
      current = [p];
      last = p;
    },
    lineTo(x: number, y: number): void {
      if (current === null || last === null) fail('lineTo without moveTo');
      const p: Point = [Math.round(x), Math.round(y)];
      if (p[0] === last[0] && p[1] === last[1]) return;
      current.push(p);
      last = p;
    },
    closePath(): void {
      fail('closePath is not expected in open lines');
    },
    beginPath(): void {
      // GeoContext requires beginPath; open-line state is reset in moveTo.
      return;
    },
    arc(): never {
      fail('arc not supported');
    },
    rect(): never {
      fail('rect not supported');
    },
  };
  geoPath(
    geoIdentity().clipExtent([
      [0, 0],
      [W, height],
    ]),
    ctx as never,
  )(geometry as never);
  flush();
  return parts.join('');
}

async function readLayer(prgDir: string, base: string): Promise<PrgFeature[]> {
  const collection = await readShapefile(
    join(prgDir, `${base}.shp`),
    join(prgDir, `${base}.dbf`),
    { encoding: 'utf-8' },
  );
  return collection.features as PrgFeature[];
}

function matchCounties(
  a01: PrgFeature[],
  a02: PrgFeature[],
  region1: readonly Region1[],
  region2: readonly Region2[],
): MatchedCounty[] {
  const voivodeshipCodeByName = new Map<string, string>();
  for (const f of a01) {
    const name = f.properties.JPT_NAZWA_;
    const code = f.properties.JPT_KOD_JE;
    if (voivodeshipCodeByName.has(name)) {
      fail(`ambiguous A01 voivodeship name ${name}`);
    }
    voivodeshipCodeByName.set(name, code);
  }

  const letterToCode = new Map<string, string>();
  for (const r1 of region1) {
    const code = voivodeshipCodeByName.get(r1.name);
    if (code === undefined) {
      fail(`unmatched registry region1 ${r1.name}`);
    }
    letterToCode.set(r1.letters[0], code);
  }
  for (const [name, code] of voivodeshipCodeByName) {
    if (!region1.some((r) => r.name === name)) {
      fail(`leftover A01 voivodeship ${name} (${code})`);
    }
  }

  const aliasToRegistry = new Map(NAME_ALIASES.map((a) => [a.prg, a.registry]));

  type Key = string;
  const keyOf = (voivodeshipCode: string, kind: string, name: string): Key =>
    `${voivodeshipCode}\0${kind}\0${name}`;

  const registryByKey = new Map<Key, Region2>();
  for (const r2 of region2) {
    const voivodeshipCode = expectDefined(
      letterToCode.get(r2.region1Letter),
      `voivodeship code for ${r2.region1Letter}`,
    );
    const key = keyOf(voivodeshipCode, r2.kind, r2.name);
    if (registryByKey.has(key)) {
      fail(`ambiguous registry region2 key ${key}`);
    }
    registryByKey.set(key, r2);
  }

  const matched: MatchedCounty[] = [];
  const usedKeys = new Set<Key>();
  const problems: string[] = [];

  for (const f of a02) {
    const teryt = f.properties.JPT_KOD_JE;
    const voivodeshipCode = teryt.slice(0, 2);
    const kind = countyKind(teryt);
    const prgName = stripPowiatPrefix(f.properties.JPT_NAZWA_);
    const name = aliasToRegistry.get(prgName) ?? prgName;
    const key = keyOf(voivodeshipCode, kind, name);
    const r2 = registryByKey.get(key);
    if (r2 === undefined) {
      problems.push(
        `unmatched PRG county ${teryt} (${kind}, ${prgName} → ${name})`,
      );
      continue;
    }
    if (usedKeys.has(key)) {
      problems.push(`ambiguous PRG county for ${name} (${teryt})`);
      continue;
    }
    usedKeys.add(key);
    if (f.geometry === null) {
      fail(`PRG county ${teryt} has null geometry`);
    }
    const area = geoArea(f);
    if (area >= 0.01) {
      fail(`winding guard failed for A02 ${teryt}: geoArea=${area}`);
    }
    matched.push({
      teryt,
      voivodeshipCode,
      region1Letter: r2.region1Letter,
      firstSuffix: r2.suffixes[0],
      name: r2.name,
      kind: r2.kind,
      geometry: f.geometry,
    });
  }

  for (const r2 of region2) {
    const voivodeshipCode = expectDefined(
      letterToCode.get(r2.region1Letter),
      `voivodeship code for ${r2.region1Letter}`,
    );
    const key = keyOf(voivodeshipCode, r2.kind, r2.name);
    if (!usedKeys.has(key)) {
      problems.push(
        `leftover registry region2 ${r2.region1Letter}/${r2.name} (${r2.kind})`,
      );
    }
  }

  if (problems.length > 0) {
    fail(problems.join('; '));
  }

  matched.sort((a, b) => (a.teryt < b.teryt ? -1 : a.teryt > b.teryt ? 1 : 0));
  return matched;
}

function matchDistricts(
  a05: PrgFeature[],
  warsawDistricts: WarsawDistrictsData,
): MatchedDistrict[] {
  const selected = a05.filter((f) =>
    /^1465\d\d_8$/.test(f.properties.JPT_KOD_JE),
  );
  if (selected.length !== 18) {
    fail(`expected 18 Warsaw districts, got ${selected.length}`);
  }

  const expectedNames = [
    ...new Set(
      warsawDistricts.rows.flatMap((row) => row.districts.map((d) => d.value)),
    ),
  ].sort();

  const districts: MatchedDistrict[] = [];
  for (const f of selected) {
    const teryt = f.properties.JPT_KOD_JE;
    const name = stripDistrictSuffix(f.properties.JPT_NAZWA_);
    if (f.geometry === null) {
      fail(`Warsaw district ${teryt} has null geometry`);
    }
    const area = geoArea(f);
    if (area >= 0.01) {
      fail(`winding guard failed for A05 ${teryt}: geoArea=${area}`);
    }
    districts.push({ teryt, name, geometry: f.geometry });
  }

  const gotNames = districts.map((d) => d.name).sort();
  if (gotNames.join('\0') !== expectedNames.join('\0')) {
    fail(
      `Warsaw district names mismatch: PRG=[${gotNames.join(', ')}] D-57=[${expectedNames.join(', ')}]`,
    );
  }

  districts.sort((a, b) =>
    a.teryt < b.teryt ? -1 : a.teryt > b.teryt ? 1 : 0,
  );
  return districts;
}

function fitProjection(target: FeatureCollection<Polygon | MultiPolygon>): {
  readonly projection: (coords: [number, number]) => [number, number] | null;
  readonly height: number;
} {
  const projection = geoTransverseMercator().rotate([-19, 0]);
  projection.fitWidth(W - 2 * M, target);
  const [[, y0], [, y1]] = geoPath(projection).bounds(target);
  const height = Math.ceil(y1 - y0) + 2 * M;
  projection.fitExtent(
    [
      [M, M],
      [W - M, height - M],
    ],
    target,
  );
  return { projection, height };
}

function serializeCountyMap(map: CountyMap): string {
  const counties = map.counties
    .map(
      (c) =>
        `    {\n` +
        `      region1Letter: ${JSON.stringify(c.region1Letter)},\n` +
        `      firstSuffix: ${JSON.stringify(c.firstSuffix)},\n` +
        `      teryt: ${JSON.stringify(c.teryt)},\n` +
        `      path: ${JSON.stringify(c.path)},\n` +
        `      label: { x: ${c.label.x}, y: ${c.label.y}, radius: ${c.label.radius} },\n` +
        `    }`,
    )
    .join(',\n');
  const neighbours = map.neighbours
    .map((p) => `    ${JSON.stringify(p)}`)
    .join(',\n');
  return (
    `{\n` +
    `  viewBox: { width: ${map.viewBox.width}, height: ${map.viewBox.height} },\n` +
    `  outline: ${JSON.stringify(map.outline)},\n` +
    `  counties: [\n${counties}\n  ],\n` +
    `  neighbours: [\n${neighbours}\n  ],\n` +
    `}`
  );
}

